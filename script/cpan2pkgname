package cpan2pkgname::CLI;

use v5.44;

use IO::Handle::Common;
use Getopt::Long
  qw(GetOptionsFromArray :config no_ignore_case auto_abbrev bundling long_prefix_pattern=--?);

sub cli {
    my %pkgname;
    my %cliopt = ( in => [] );

    GetOptionsFromArray(
        \@ARGV,
        \%cliopt,
        'quiet', 'in=s@',
        '<>' => sub ($bare) {
            push $cliopt{in}->@*, $bare;
        }
    );

    foreach my $in ( $cliopt{in}->@* ) {
        $pkgname{$in} = cpan2pkgname->convert($in);

        my $outstr = "$pkgname{$in}";
        $outstr = "$in: $outstr" unless $cliopt{quiet};
        say $outstr;

        if ( my @fail = grep { !$pkgname{$_} } keys %pkgname ) {
            say STDERR "Skipped the following due to errors:";
            say STDERR join "\n", @fail;
        }
    }

    if(-t <>) {
        
    }

    dmsg \%pkgname;
}

cli
