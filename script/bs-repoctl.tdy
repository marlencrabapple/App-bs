#!/usr/bin/env perl
use Object::Pad ':experimental(:all)';
use lib 'lib';

package BS::repoctl;

class BS::repoctl;    #: isa(App::BS::CLI);

use utf8;
use v5.40;

use List::Util 'first';
use Const::Fast;
use Path::Tiny;
use IPC::Nosh;
use IO::Handle::Common;

use BS::Common;
use BS::GPG;

const our @clispec => (

# TODO: Simplify below with somethign like App::BS::CLI::optkeyptn(qr//)
# More than likely there's a module that expands a regular expression into defined possibilities
    'gpg-key|-signing-key|-key|gpg-pubkey|gpg-fpr|gpg-fingerprint=s',
    'verifydb|verify-database-signature|verify-db-signature',
    'clobber',
    'update-only|new|freshen-up',
    'repo-db|repo-database|db-file=s',
    '<>' => sub ($barearg) {
        try {
            my $path = path($barearg)->assert( sub { $_->exists } );
        }
        catch ($e) {
            say STDERR "$e";
        }
    }
);

field $repo;
field $repodb;
field $repo_abspath;
field $gpgiden : param(gpgid) = $ENV{BS_GPGFPR} // $ENV{BS_GPGPUBID};

field $pkgqueue : param(packages) =
  path( %ENV{ first { $ENV{$_} && -d $ENV{$_} } qw'BS_PKGDEST PKGDEST' } )
  ->children(qr/.+-(any|x86_64_v3)\.pkg.tar.zst/);

ADJUSTPARAMS($params) {
    dmsg( $self, $params );
    $self->getopts_setup = $$params{clispec} //= \@clispec
}

method sign( $pkg_aref = $pkgqueue, %opts ) {
    die "\$pkg_aref (" . Dumper($pkg_aref) . ")" unless $pkg_aref isa 'ARRAY';

    my $runerr =
      run( [ qw(gpg -sb -u), $opts{gpgiden} //= $gpgiden, @$pkg_aref ],
        undef, $self->handler(qw(out err)) );

    $self;
}

method copy ( $pkg_aref = $pkgqueue, %opts ) {
    $self;
}

method $repoadd ( $files, $repodb, %opt ) {
    my @out;
    my $gpgid  = $opt{gpgid}  // $gpgiden;
    my $repodb = $opt{repodb} // $repodb;

    my @repoadd_arg = qw(psv);
    push @repoadd_arg, "n" if $opt{clobber};

    my @gpgid =
      $gpgid && BS::GPG::can_sign($gpgid)
      ? ( "-k", $gpgid )
      : ();

    my $ret = run(
        [
            qw(repo-add --include-sigs),     @gpgid,
            "-" . ( join "", @repoadd_arg ), $repodb,
            @$files
        ],
        out => \@out
    );
}

method repoadd ( $pkg_aref = $pkgqueue, %opt ) {
    my @gpgid;
    my @repoadd_arg;

    if ( $opt{ignore_error} ) {
        foreach my $pkg (@$pkg_aref) {

        }

    }
    else {

        my @out;
        my $ret = run(
            [
                qw(repo-add --include-sigs),     @gpgid,
                "-" . ( join "", @repoadd_arg ), $repodb,
                @$pkg_aref
            ],
            out => \@out
        );
    }
    $self;
}

method $run (%opts) {
    $self->sign->copy->repoadd;
}

method cli : common ($argv = \@ARGV,%opt) {    #, %opts = ()) {
    my @clispec;
    my $dest = $opt{dest};

    $opt{constructor} = {} unless $opt{constuctor} && ref isa 'HASH';

   # die "\$opts{constructor} ("
   #   . ( Dumper( $opts{constructor} ) =~ s/\$VAR1 = ([^;]+);?[\n\r]+$/= $1/r )
   #   . ') must be a hashref.'

    my $self = $class->new(
        argv    => $argv,
        dest    => $dest,
        clispec => \@clispec,
        $opt{constructor}
    );

    my $res = $self->$run(%opt);

    ( $self, $res );
}

#
# Entrypoint
#

package bsrepoctl;

use lib 'lib';

use utf8;
use v5.40;
use BS::Common;

my %cli = ();
my ( $app, $asdf ) = BS::repoctl->cli( argv => \@ARGV, dest => \%cli );
