#!/usr/bin/env perl

use Object::Pad ':experimental(:all)';

use lib 'lib';

package srcinfo;

class srcinfo : does(BS::Common);

use utf8;
use v5.40;

use parent 'Exporter';
use vars '@EXPORT';

@EXPORT = qw(srcinfo);

use Cwd;
use Getopt::Long qw'GetOptionsFromArray :config bundling auto_abbrev';
use Path::Tiny;
use Const::Fast;
use JSON::MaybeXS;
use TOML::Tiny;
use YAML::Tiny;
use Const::Fast::Exporter;

const our $PKGVER_CURR =>;

our $json = JSON::MaybeXS->new( utf8 => 1, pretty => 1 );

field $argv : param //= \@ARGV;
field $cliopt : param(clidest) //= {};
field $clispec : param;

field $path : param = $$cliopt{path};    # //= Cwd::abs_path(cwd) . '/.SRCINFO';
field $basename;                         #= $path->basename;
field $parentdir;                        # = $path->parentdir;

field $srcinfo : reader = {};

ADJUSTPARAMS($params) {
    foreach my ( $k, $v ) (@$clispec) {
        my $ogsub = $v;
        $v = sub ($barearg) {
            $ogsub->( $self, $barearg );
          }
          if ref $ogsub eq 'CODE';
    }

    GetOptionsFromArray( $argv, $cliopt, @$clispec );

# BS::Common::dmsg({ self => $self, cliopt => $cliopt, argv => $argv, clispec => $clispec, path => $path,params => $params });

    die 'No .SRCINFO files provided' unless $path;
}

# sub srcinfo ($path, %opts) {
#   # __PACKAGE__->load($path)
#   my $self = __PACKAGE__->run($path);
#   $self->srcinfo
# }

method parse_srcinfo : common ($path) {
    const my $SRCINFO_LINE_RE => qr/^\s*([a-z0-9_]+?)\s*=\s*(.+?)[\s\n]*$/i;
    const my $XDEPENDS_RE     => qr/depends/i;

    my %srcinfo = ();

    foreach my $line ( $path->lines_utf8 ) {
        my ( $key, $val ) = ( $line =~ $SRCINFO_LINE_RE );
        next unless $key && $val;

        if ( ref $srcinfo{$key} eq 'ARRAY' ) {
            push $srcinfo{$key}->@*, $val;
        }
        elsif ( $srcinfo{$key} ) {
            $srcinfo{$key} = [ $srcinfo{$key}, $val ];
        }
        else {
            $srcinfo{$key} = $val;
        }
    }

    \%srcinfo;
}

method load ($_path) {
    $path = path($_path)->assert( sub { $_->is_file } );
    my $srcinfo_href = __CLASS__->parse_srcinfo($path);
    $srcinfo = $srcinfo_href;
    return $srcinfo_href;
}

sub pkgfile_glob ( $srcinfo, $pkgver ) {
    my $pkgver_str;

    if ( my $pkgver_href = ( ref $pkgver eq 'HASH' ? %$pkgver : undef )
        // ( $pkgver == $PKGVER_CURR ? $srcinfo->%{qw'epoch ver rel'} : undef )
      )
    {
        #$pkgver_str "$$pkgver"

        $pkgver_str .= "$$pkgver_href{epoch}:" if $$pkgver_href{epoch};
        $pkgver_str .= $$pkgver_href{ver};
        $pkgver_str .= "-$$pkgver_href{rel}" if $$pkgver_href{rel};
    }
    elsif ($pkgver) {
        $pkgver_str = $pkgver;
    }

    '{'
      . ( join ',', $$srcinfo{pkgname}->@* ) . "}*"
      . ( $pkgver_str ? " *-$pkgver_str-*" : "" ) . "-{"
      . ( join ',', $$srcinfo{arch}->@* )
      . '}.pkg.tar.zst';
}

method fn_as_glob ( $pkgver = undef ) {  # pass your own or set to 1 for current
    glob( $srcinfo, $pkgver );
}

method $run (%opts) {
    $srcinfo = $self->load($path);
    $self;
}

method run : common ($argv = \@ARGV,  %opts) {
    state @queue = ();
    my $self = $class->new( argv => $argv, %opts{qw'clispec clidest'} );
    push @queue, $self;
    $self->$run;
}

package main;

use utf8;
use v5.40;

use Path::Tiny;
use JSON::MaybeXS;

our @wuwue;

our %clidest = (
    format         => 'json',
    'pretty-print' => 1
);

our @clispec = (
    'help|?', 'lint',
    'pretty-print',
    'format|out-format|serialize=s',
    '<>' => sub ( $self, $barearg ) {
        try {
            my $asdf = $self->load($barearg);

    # BS::Common::dmsg({ loadout => $asdf, barearg => $barearg, self => $self })
        }
        catch ($e) {
            BS::Common::fatal($e)
        }
    }
);

my $app = srcinfo->run(
    \@ARGV,
    clispec => \@clispec,
    clidest => \%clidest,
    queue   => \@wuwue
);

BS::Common::dmsg( { srcinfo => $app->srcinfo, json => $srcinfo::json } );
my $srcinfo_href = $app->srcinfo;
use Data::Dumper;

#my $json = $srcinfo::json;
#say Dumper($srcinfo_href, $json);
#say $json->encode_json($srcinfo_href)

say encode_json($srcinfo_href);
$app->fn_as_glob;

