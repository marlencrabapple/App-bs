#!/usr/bin/env perl

use Object::Pad ':experimental(:all)';

package bs_repo_vercmp;

class bs_repo_vercmp : does(Adjust::Params) : does(App::BS::Package::Version) :
  does(App::BS::Ext::pacman::Config) : does(App::BS::Run);

use v5.40;
use utf8;

use List::Util qw'any all none uniq';
use IO::Handle::Common;
use Time::HiRes;
use Syntax::Keyword::Dynamically;
use Syntax::Keyword::Defer;
use Const::Fast;

use App::BS::Package::Version;

no warnings 'experimental::re_strict';
use re 'strict';

field $repo           : accessor;
field $filter         : accessor;
field $lastsync       : accessor;
field $updatedb       : param : reader = 1;
field $cmp_pkgrel     : param : reader = 0;
field $installed_only : param : reader = 0;
field $verbose        : param = 0;
field $outfmt         : accessor : param = undef;
field $quiet          : accessor : param = undef;
field $pkg = {};

# ADJUST : params (:$updatedb //= 1) {
#     $self->param_bool( updatedb => $updatedb );
# };

# ADJUST : params (:$cmp_pkgrel //= 0)
#   { $self->param_bool( cmp_pkgrel => $cmp_pkgrel ) };

ADJUST : params (%param) {
    dmsg $self->META;
    my %paramnorm = ();

    foreach my ( $k, $v ) (%param) {
        my ($knorm) = ($k) = ( $k =~ s/-/_/r );

        # my field= $self->$knorm;
        $paramnorm{$knorm} = $v;
    }

    $self->adjust_params(
        [ \$cmp_pkgrel, \$updatedb, \$installed_only, \$verbose, \$outfmt ],
        \%paramnorm );

    dmsg( $self, \%param, \%paramnorm )
};

ADJUST : params (:$repo, :$filter //= undef) {

    # $repo =

   # TODO: Compare repos definied somewhere in BS config/env to repos enabled in
   # pacman.conf excluding dupes
   # - do arch based distros list repos shipped with anywhere dependable?
   # - ...
    fatal "repo must be an ARRAY ref with >=2 repositories"
      unless ref $repo
      && ref $repo eq 'ARRAY'
      && scalar @$repo >= 2;

    $self->repo($repo);

    if ($filter) {
        $self->filter(
            ( ref $filter && ref $filter eq 'Regexp' ? $filter : qr/$filter/ )
        );
    }
};

# ADJUST { dmsg $self }

method param_bool ( $name, $val ) {
    if ( $val && $val !~ /^(0|1)$/ ) {
        my $errstr = "Unexpected for $name: $val. Assuming ";
        $errstr .= $val && 1 ? 'truthy' : 'falsey';
        $errstr .= '...';
        error $errstr;
    }

    $self->$name( ( $val && 1 ) );
    dmsg $self;
}

method epoch : common ($sep = '') {
    join $sep, Time::HiRes::gettimeofday;
}

method repo_listpkg : common ($repo, %opt) {
    ...;
}

method $package_seen ( $pkg, %opt ) {
    ...;
}

method repo_vercmp ( $repo = $self->repo, %opt ) {

    info "Stripping pkgrel from version strings before comparison..."
      unless $cmp_pkgrel;

    # my %pkg = ();
    my $repo_prev;

    foreach my $repo (@$repo) {
        my @repolist_cmd = (qw'pacman -S -l');
        $$pkg{$repo} //= {};

        defer { $repo_prev = $repo }

        if ( $updatedb && !$lastsync ) {
            unshift @repolist_cmd, 'sudo';
            push @repolist_cmd, '-y';
        }

        const my $repolist_line_re => qr/^
          $repo\s
          ([^\s]+)\s # name
          ([^\s]+) # ver
          (?:\s
          (\[installed # installed
            (?::\s
            ([^\]]+) # ver from other repo
            )?\]
          ))?
          $/xi;

        my $vercmp_outh = sub ( $line, $pkg, $name, $repo, $repo_prev, $ver ) {
            if ($line) {
                my @ver =
                  map { $cmp_pkgrel ? $_ : ( $_ =~ s/-[0-9]+$/-x/r ) }
                  ( $ver, $pkg->{$repo_prev}{$name}{ver} );

                if ($outfmt) {
                    const my %fmtmap => (
                        base => '%e',
                        name => '%n',
                        repo => '%r',
                    );

                    const my %_fmtmap => ( reverse %fmtmap );

                    my $ptn = join '|', map { quotemeta($_) } values %fmtmap;

                    my $outstr = ( $outfmt =~ s/($ptn)/$_fmtmap{$1}/gr );
                    say $outstr;
                }
                else {
                    if ($quiet) {
                        say $name;
                    }
                    else {
                        say "$repo_prev/$name ("
                          . $ver[1]
                          . ") is newer than $repo/$name ($ver[0])";
                    }
                }
            }
        };

        my $repolist_outh = sub ( $line, @ ) {

            my ( $name, $ver, $installed, $localver ) =
              $line =~ $repolist_line_re;

            if ( none { $_ } $name, $ver ) {
                return
                  if $line =~ /^::/
                  || $line =~ /^\s*[^\s]+ downloading.../;

                error "Encountered error processing pacman output:\n  $line";

                dmsg $repo, $line;

                return;
            }

            if ( !$filter || $name =~ $filter ) {
                my %currpkg = (
                    ver       => $ver,
                    installed => (
                        $installed && $installed =~ /^\[installed/ ? 1 : undef
                    ),
                    localver => $localver
                );

                if ( $pkg->{$repo}{$name} ) {
                    error "Package already processed: $repo/$name. Ignoring...";
                    dmsg $line, \%currpkg, $pkg->{$repo}{$name};
                }
                if ( !$repo_prev || $pkg->{$repo_prev}{$name} ) {
                    $pkg->{$repo}{$name} //= \%currpkg
                      unless $installed_only && !$installed;
                }

                if (   $repo_prev
                    && $pkg->{$repo_prev}{$name} )
                {
                    $vercmp_outh->(
                        App::BS::Package::Version->vercmp(
                            $ver, $pkg->{$repo_prev}{$name}{ver}
                        ),
                        $pkg, $name, $repo,
                        $repo_prev,
                        $ver
                    );
                }
            }
        };

        my $run =
          $self->run( [ @repolist_cmd, $repo ], out => $repolist_outh, );

        if ( $run->status == 0 ) {
            $lastsync = __PACKAGE__->epoch if $updatedb;
        }
    }
}

package bs_repo_vercmp::CLI;

use v5.40;

use IO::Handle::Common;
use Getopt::Long
  qw(GetOptionsFromArray :config no_ignore_case auto_abbrev bundling long_prefix_pattern=--?);

sub run ( $argv = \@ARGV ) {
    my @repo;
    my %clidest = ( repo => \@repo, updatedb => 1, cmp_pkgrel => 0 );

    GetOptionsFromArray(
        $argv,
        \%clidest,
        'updatedb|sync!',
        'filter|pattern|search|regexp|ptn:s',
        'installed-only!',
        'pacman-config:s',
        'cmp-pkgrel|pkgrel|compare-pkgrel!',
        'outfmt|format:s',
        'quiet',
        '<>' => sub ($repo) {
            push @repo, $repo;
        }
    );

    # dmsg \%clidest;

    my $app = bs_repo_vercmp->new(%clidest);

    $app->repo_vercmp;
}

run( \@ARGV )
