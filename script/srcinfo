method as ( $format = $self->format, $field = $self->field ) {
    $srcinfo->as( $format, $field );
}

method cli : common ($argv, $clispec, $dest //= {}, %opt) {
    my $self = $class->new(
        clispec => $clispec,
        argv    => $argv,
        clidest => $dest
    );

    dmsg $self;

    say $self->as( @$dest{qw(format field)} );
    $self;
}

method load ( $in = $infile ) {
    $infile  = $in;
    $srcinfo = BS::Package::SRCINFO->new( file => $in );
}

package main;

use v5.40;

use Path::Tiny;
use IPC::Nosh::Common;

our @clispec = (
    'field|fields|out-fields|outfields|filter|select' => 's{1,}',
    'format|out-format|fmt|of|outfmt'                 => 's',
    'pretty-print!'                                   => 'f',
    '<>' => sub ( $self, $barearg ) {
        my $srcinfo =
          $self->load( path($barearg)->assert( sub { $_->exists } ) );
    }
);

our %cliopt = ( field => [] );

our $cli = srcinfo::cli->cli( \@ARGV, \@clispec, \%cliopt );
dmsg $cli;
