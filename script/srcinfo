#!/usr/bin/env perl

use Object::Pad ':experimental(:all)';

package srcinfo;
class srcinfo : does(BS:Common);

use File::chdir;
use Cwd;
use Path::Tiny;

field $srcinfo = {};
field $path :param = path(Cwd)
field $basename = $path->basename;
field $parentdir $path->parentdir;

ADJUSTPARAMS ($params) {
  BS::Common::dmsg({self => $self, params => $params});
  ...
}

method parse_srcinfo {
  $CWD = $path->parentdir;
  ...
}

method $run {
  $self->parse_srcinfo
}

sub run :common ($argv = \@ARGV, $clidest = {}, %opts) {
  $class->new(argv => $argv, dest => $clidest, %opts)
}

package main;

srcinfo->run(\@ARGV)