#!/usr/bin/env perl
use Object::Pad qw(:experimental(:all));

package pkgbase;

use lib 'lib';

class pkgbase : isa(App::BS);

#: does(BS::Ext::expac)
#: does(BS::Ext::pacman)
#: does(BS::Ext::User);

use utf8;
use v5.40;

use subs 'dmsg';

use Carp;
use IPC::Run3;
use List::Util qw(any uniqstr all first);
use Syntax::Keyword::MultiSub;
use Syntax::Keyword::Dynamically;
use Syntax::Keyword::Try;
use Const::Fast;

use BS::Ext::expac;
use BS::Ext::pacman;

#use BS::Ext::pacinfo;

const our $VALID_PKG_RE_CCLASS_START => "a-zA-Z0-9\@_\+";

const our $VALID_PKG_RE_NB =>
qr/[$VALID_PKG_RE_CCLASS_START]{1}[$VALID_PKG_RE_CCLASS_START\.\-]+(\.so)|[$VALID_PKG_RE_CCLASS_START]{1}[$VALID_PKG_RE_CCLASS_START\.\-]+/;

const our $PACINFO_SO_PREFIX => qr/(?:lib\:)?/;
const our $DEP_SO_RE         => qr/\.so/;

const our $VALID_DEPIDEN_RE =>
  qr/$PACINFO_SO_PREFIX($VALID_PKG_RE_NB)(?:$DEP_SO_RE)?/;

const our $DEP_ATTRSEP_RE => qr/(?:\=)|(?:[\<\>]\=?)|(?:(?:\:)|(?:[\.\-]{1}))/;

const our $PKGVER_FORBIDDENCH => quotemeta(':/-') . '\s';
const our $PKGVER_RE          => qr/[^$PKGVER_FORBIDDENCH]+/;

const our $DEP_ATTR_RE =>
  qr/^$VALID_DEPIDEN_RE(?:\s*($DEP_ATTRSEP_RE)(?:\s*)($PKGVER_RE|.+))?\n?$/;

BS::Common::dmsg $DEP_ATTR_RE, $PKGVER_FORBIDDENCH, $PKGVER_RE,
  $DEP_ATTRSEP_RE, $VALID_DEPIDEN_RE;

method pacman_query : common ($pkgstr, %opts) {
    const my $FILEDB_RE      => qr/files?/;
    const my $REPOPKG_SEP_RE => qr/(^[^\/]+)?\/($VALID_PKG_RE_NB[^\n])$/;

    my $res =
      $opts{database} && $opts{database} =~ $FILEDB_RE
      ? BS::Ext::pacman->file_query($pkgstr)
      : BS::Ext::pacman->pkg_query($pkgstr);

    my $match = first { $_ && $$_{pkgname} } $res->dest->@*;

    BS::Common::dmsg { pkgstr => $pkgstr, match => $match, res => $res };

    #chomp $match;

    #[ split /$REPOPKG_SEP_RE/, $match ];
    $match;
}

method parse_pkgstr : common ($pkgstr, %opts) {

    # These are newer/more general versions of constants above/in other
    # modules (currently, at least)
    const my $pkgstr_name_ptn => qr'[a-zA-Z0-9\@_\+]{1}[a-zA-Z0-9\@_\+\.\-]+';

    const my $pkgstr_name_re =>
      qr/^(lib\:)?($pkgstr_name_ptn(\.so(?:\.[0-9]+)?)|$pkgstr_name_ptn)/;

    const my $pkgver_forbidden => quotemeta(':/-') . '\s';

    #const my $pkgver_delim     => qr'(?:(\=|[\<\>]\=?)';

    const my @pkgstr_re_arr => (
        $pkgstr_name_re,             '(?:(\=|[\<\>]\=?)',
        "([^$pkgver_forbidden]+))?", '|(?:(:)\s*(.+))?'
    );

    const my $pkgstr_re_str => join '', @pkgstr_re_arr;

    const my $pkgstr_re  => qr/@pkgstr_re_arr/;    # Not working...
    const my $_pkgstr_re => qr/$pkgstr_re_str/;

    BS::Common::dmsg { nojoin => $pkgstr_re, join => $_pkgstr_re };

    my ( $prefix, $_pkgstr, $isfile, $sep, $attr, @extra ) =
      $pkgstr =~ $_pkgstr_re;

    my %pkgstub = ();

    $pkgstub{name} = $_pkgstr;

    if ($sep) {
        if ( $sep ne ':' ) {
            $pkgstub{version} = $attr;
            $pkgstub{cmp_op}  = $sep;
        }
        elsif ( $sep eq ':' ) {    # Optional dependency most likely
                                   # Will have parsed that out elsewhere
            $pkgstub{description} = $attr;
            $pkgstub{name}        = $_pkgstr;
        }
    }

    if ( $isfile || $opts{database} && $opts{database} eq 'file' ) {
        $pkgstub{file} //= $_pkgstr;

        my $res = $class->pacman_query( $_pkgstr, database => 'file' );

        #BS::Common::dmsg { res => $res };

        $pkgstub{repo} = $$res{repo}    if $$res{repo};
        $pkgstub{name} = $$res{pkgname} if $$res{pkgname};
    }

    BS::Common::dmsg(
        {
            _pkgstr => $_pkgstr,
            isfile  => $isfile,
            sep     => $sep,
            attr    => $attr,
            pkgstub => \%pkgstub
        }
    ) if $BS::Common::DEBUG;

    \%pkgstub;
}

method $parse_line : common ($line, %opts) {
    const my $DEPKEY_RE => qr/^(Requires|Optional Deps)$/i;

    my ( $key, $value ) = map {
        $_ =~ s/$BS::Common::TRIM_RE/$1/;
        $_
    } ( split /:/, $line, 2 );

    return undef unless $key && $value;

    $key = lc($key);
    $key =~ s/[^a-z0-9]+/_/;

    $value = $class->pkgbase( $class->parse_pkgstr($value), %opts )->{name}
      if ( $opts{resolve_deps} // 0 ) && $key =~ $DEPKEY_RE;

    $key, $value;
};

method $parse_pacinfo : common ($aref, %opts) {
    const my @VALID_KEYS => qw(Name Base Repository);

    const my $VALID_KEY_RE => map { qr/^($_)$/i } join '|',
    (@VALID_KEYS);

    my $pacinfo_href = {};

    foreach my $line (@$aref) {
        chomp $line;

        $line =~ s/$BS::Common::TRIM_RE/$1/;

        my ( $key, $val ) = $class->$parse_line( $line, %opts );

        next unless $key && $val;

        if ( $$pacinfo_href{$key} ) {
            next
              if ( $opts{no_dupes}
                && $opts{dest}->{$key}
                && $$pacinfo_href{$key} eq $opts{dest}->{$key} );

            $$pacinfo_href{$key} = [ $$pacinfo_href{$key} ]
              if ref $$pacinfo_href{$key} ne 'ARRAY';

            unshift $$pacinfo_href{$key}->@*, $val;
        }
        else {
            $$pacinfo_href{$key} = $val;
        }
    }

    $pacinfo_href;
  }

  method pkgbase : common ($pkgstr, %opts) {
    const my $S_PKGBASE_PKGSTR_EMPTY =>
      "Error: \$pkgstr cannot be undefined or empty!";

    #BS::Common::dmsg {
    #    err    => $S_PKGBASE_PKGSTR_EMPTY,
    #    pkgstr => $pkgstr,
    #    opts   => \%opts
    #};

    warn $S_PKGBASE_PKGSTR_EMPTY
      unless $pkgstr && $pkgstr !~ /^\s*$/;

    my $base =
      BS::Ext::expac->search( "^$pkgstr\$", %opts, fields => ['base'] )
      ->dest->[0]{base};

    $base;
}

method handle_barearg ($str) {
    if ( length $str == 1 && $ARGV[-1] eq $str ) {
        $self->cliopts->{seperator} = $str;
    }
    else {
        push $self->queue->@*, $str;
    }
}

method pacinfo : common ($pkgstr, %opts) {
    my ( @out, $err );
    run3 [ 'pacinfo', $pkgstr ], \undef, \@out, \$err;
    $class->$parse_pacinfo( \@out, %opts );
}

method run {
    my @pkgbase = ();

    const my $DEFORDER_RE => qr/^asc.*/i;

    state $altorder =
      ( $self->cliopts->{default_order} // 'asc' ) =~ $DEFORDER_RE
      ? 'desc'
      : 'asc';

    state $altorder_re = qr/^($altorder|r).*/i;

    foreach my $pkgstr ( $self->queue->@* ) {
        const my $PKGEXT_REGESC =>
          quotemeta( $self->env->{pkgext} // $ENV{PKGEXT} );

        const my $PKGEXT_RE => qr/$PKGEXT_REGESC$/i;

        if ( $pkgstr =~ $PKGEXT_RE ) {
            if ( my $pkgfile = BS::Path->if_exists($pkgstr) ) {
                $pkgstr = $pkgfile->basename(
                    ext => ( $self->env->{pkgext} // $ENV{PKGEXT} ) );
            }
            else {
                const my $S_PKGSTR_ISFILE_404 =>
                  "'$pkgstr' was provided as a package file but was not "
                  . "found in the current working directory!";

                carp $S_PKGSTR_ISFILE_404;

                $pkgstr =~ s/$PKGEXT_RE//i;
            }
        }

        my $pkgstub = __CLASS__->parse_pkgstr( $pkgstr, $self->cliopts->%* );
        my $pkgbase = __CLASS__->pkgbase( $$pkgstub{name}, $self->cliopts->%* );

        if ( all { $_ } ( $pkgstub, $pkgbase ) ) {
            push @pkgbase, $pkgbase;
        }
        else {
            const my $S_RESOLVEERR =>
              "Could not resolve package for '$pkgstr'!";

            warn $S_RESOLVEERR;
            BS::Common::dmsg {
                pkgstr  => $pkgstr,
                pkgstub => $pkgstub,
                pkgbase => $pkgbase
            };

            # pacsift --ownsfile "$pkgstr"
            # expac -
        }
    }

    @pkgbase = $self->cliopts->{unique} ? uniqstr @pkgbase : @pkgbase;

    @pkgbase =
      ( $self->cliopts->{order} !~ $altorder_re )
      ? @pkgbase
      : reverse @pkgbase;

    say join $self->cliopts->{sep} // ' ',
      $self->cliopts->{reverse} ? reverse @pkgbase : @pkgbase;
}

our %opts = (
    unique => 1,
    sync   => 1,
    order  => 'asc'
);

package main;

our @queue;

my $app = pkgbase->new(
    getopts => [
        "pkgbuild-repo|pkgmeta:s",            "seperator:s",
        "order|sort-direction|print-order:s", "optional|o:i",
        "reverse|r",                          "depth|max-depth:i",
        "delimiter:s",                        "sync!",
        "fetch",                              "unique!",
        "updpkgsums",                         "update!",
    ],
    argv  => \@ARGV,
    dest  => \%opts,
    queue => \@queue
);

$app->run;
