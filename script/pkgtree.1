#!/usr/bin/env perl

use v5.40;
$ENV{DEBUG} = 1;
use Getopt::Long qw(GetOptionsFromArray :config no_ignore_case auto_abbrev);
use List::Util 'any';
use IPC::Nosh;
use IPC::Nosh::IO;

our @in;    # = @ARGV;
our %state;
our @found;
our %clidest;

GetOptionsFromArray(
    \@ARGV,
    \%clidest,
    'find|search|pkgname=s{,}',
    '<>' => sub ($in) {
        push @in, $in;
    }
);

for my $pkg (@in) {
    my @out;
    my $run = run3(
        [ qw(expac -S %D), $pkg ],
        \undef,
        sub ($line) {
            chomp $line;
            push @out, $line;
        }
    );

    foreach my $line (@out) {
        my @deps = split /\s/, $line;
        foreach my $dep (@deps) {
            $state{$pkg}->{depends} = $dep;

            if ( any { $_ eq $dep } $clidest{find}->@* ) {
                push @found, $dep;
                say $dep;
            }

            push @in, $dep;
        }
    }
}

say join " ", @found
