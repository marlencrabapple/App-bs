#!/usr/bin/env perl

use Object::Pad ':experimental(:all)';

package pkgtree;

class pkgtree : does(App::BS::Ext::pacman) : does(App::BS::Ext::expac) :
  does(App::BS::Ext::pactree) : does(App::BS::Ext::arch_rebuild_order);

use utf8;
use v5.44;

no warnings 'experimental::re_strict';
use re 'strict';

use builtin;
use Const::Fast;
use List::Util qw'pairgrep first uniq none any';
use IO::Handle::Common;
use PadWalker;
use Syntax::Keyword::Dynamically;

const our @SORT_ALLOW => qw( buildorder );

field $in     : param;
field $pinned : param(variant);

field $buildorder : param = 1;

field $sortby  : param = qw'buildorder';
field $sortdir : param = 'desc';

# field $asc;
# field $desc;
# field $reverse;

field $reversedeps : param = 0;
field $field  : param : accessor = [];
field $fmtstr : param : accessor = '%e';

# Default is hybrid: will do expac -Ss if pkgstr has regex meta-characters
field $exact  : param : accessor = 0;
field $regex  : param : accessor = 1;
field $sep    : param = ' ';
field $unique : param = 1;

field $pkgtree = {};

field $repo_enabled : accessor;

field $verbose : param : accessor = 0;
field $extcmd_log : accessor = [];

method resolve ( $pkglist //= $in, %opt ) {
    my @variant_pkgname;
    my @provided;

    if ( scalar @$pinned ) {
        $self->pacman_pkgname( $pinned, %opt, dest => \@variant_pkgname );
        $self->pacman_provides( $pinned, %opt, dest => \@provided );
    }

    my @in_pkgname;
    $self->pacman_pkgname( $pkglist, %opt, dest => \@in_pkgname );
    fatal "Could not find packages in the " . $self->db . 'database.'
      unless scalar @in_pkgname;
    dmsg \@in_pkgname;

    my %pactree = ( pkg => [], file => [] );
    $self->pactree( \@in_pkgname, dest => \%pactree, exact => 1 );
    push $pactree{pkg}->@*, @in_pkgname;

    $pactree{pkg}->@* = uniq $pactree{pkg}->@* if $opt{unique} // $unique;
    dmsg \%pactree;

    my @ordered;
    $self->arch_rebuild_order( $pactree{pkg}, dest => \@ordered )
      if $opt{buildorder} // $buildorder;

    dmsg \@ordered;

    $self->pkgfield(
        ( scalar @ordered ? \@ordered : $pactree{pkg} ),
        (
            first { $_ && ( reftype($_) eq 'ARRAY' ) && scalar(@$_) > 0 }
              ( $opt{field} // $field // ['base'] )
        ),
        exact => 1
    );

    # $self->pacman( ( scalar @ordered ? \@ordered : $pactree{pkg} ) );
}

package pkgtree::CLI;

use utf8;
use v5.44;

use builtin;
use List::Util qw'uniq';
use IO::Handle::Common;
use Getopt::Long
  qw(GetOptionsFromArray :config no_ignore_case auto_abbrev bundling long_prefix_pattern=--?);

sub cli ( $argv //= \@ARGV ) {
    my %clidest = (
        in      => [],
        prune   => 'input',
        sep     => ' ',
        depth   => undef,
        field   => ['base'],
        db      => 'sync',
        variant => []
    );

    my $cli2param = sub ($cliopt_href) {
        my %orig;

        foreach my ( $k, $v ) (%$cliopt_href) {
            my $_k = ( $k =~ s/-/_/rg );

            if ( $k ne $_k ) {
                $$cliopt_href{$_k} = $v;
                $orig{$_k}         = delete $$cliopt_href{$k};
            }
        }
        \%orig;
    };

    my $optval = sub ( $opt, $val ) {
        dmsg $opt, $val;
        $clidest{ $$opt{name} } = $val // defined $val;
        dmsg \%clidest;
    };

    GetOptionsFromArray(
        $argv,
        \%clidest,

        # output fields and format
        # 'base', 'name',
        'field=s@',
        'fmtstr=s',

        # database to search with pactree, expac and pacman
        'db|database:s',    # sync or local
        'sync',
        'local',
        'updatedb|update-db!' => $optval,

        # resultset print order
        'sort-by|order-by=s@',
        'build-order|rebuild-order|arch-rebuild-order!',
        'sort-direction|order',
        'asc', 'desc',
        'sep|seperator=s',
        'depth|d:i',
        'pacman-conf|config:s',

        # input search scope
        'exact!',
        'regexp',

        # output verbosity control
        'debug+',
        'verbose+',
        'quiet+',

        # enabled repositories (for sync db)
        'repolist|repo-enabled|repositories=s@',

        # print dependents of input packages
        'reversedeps|reverse-depends!',

        # prune/filter packages at different stages of resolution
        "prune:s",
        "variant|prefer|choose|chosen|wanted:s@",
        "vcs|prefer-vcs!",
        "filter:s@",

        # input packages
        '<>' => sub ($barearg) {

            # dmsg $barearg;
            push $clidest{in}->@*, $barearg;
        }
    );

    $clidest{in}->@* = uniq $clidest{in}->@* if $clidest{prune};

    my $clidest_orig = $cli2param->( \%clidest );
    my $self         = pkgtree->new(%clidest);

    dmsg $self, \%clidest, $clidest_orig;

    my @pkgtree = $self->resolve;

    say join $clidest{sep}, @pkgtree;
}

cli( \@ARGV )
