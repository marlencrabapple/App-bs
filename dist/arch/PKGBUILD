# Maintainer: Ian Bradley <crabapp@hikki.tech>
pkgname=perl-app-bs
_perl_namespace=App
_perl_module=BS
pkgver=0.01.1
pkgrel=1
pkgdesc="Build system for PKGBUILD based Linux distributions"
arch=(any)
license=('Artistic-1.0-Perl' 'GPL-1.0-or-later')
depends=('perl')
makedepends=('perl-syntax-keyword-try' 'perl-cpanel-json-xs' 'perl-module-build' 'perl-dbi' 'cpanminus' 'perl-inline-c' 'perl-path-tiny' 'perl-net-ssleay')
options=('!emptydirs')
url="https://github.com/marlencrabapple/App-bs"
source=("$pkgname::https://ppan.pi4u.lan/authors/id/C/CR/CRABAPP/${_perl_namespace}-${_perl_module}-${pkgver}.tar.gz")
b2sums=(dffsdf)
sha512sum=('cd3937afa78831f80a2ad5abab6c51b9e82fca4c31e5856ea208d598db5dc867')
validpgpkeys=(4D8733704B740FC4B330EF5E8FFAD8B7BA73987)

prepare() {
  cd "$srcdir/$pkgname"
  unset PERL5LIB PERL_MM_OPT PERL_MB_OPT PERL_LOCAL_LIB_ROOT

  _cpanm_args=(-Llocal --dev --save-dists . --verbose)

  cpanm ${_cpanm_args[*]} --installdeps .

  perl Build.PL
}

build() {
  cd "$srcdir/$pkgname"
  ./Build build
  ./Build dist
}

check() {
  cd "$srcdir/$pkgname"
  unset PERL5LIB PERL_MM_OPT PERL_MB_OPT PERL_LOCAL_LIB_ROOT
  export PERL_MM_USE_DEFAULT=1
  ./Build testall
}

package() {
  cd "$srcdir/$pkgname"
  unset PERL5LIB PERL_MM_OPT PERL_MB_OPT PERL_LOCAL_LIB_ROOT

  cpanm --verbose -L"$pkgdir/usr"

  find "${pkgdir}" -name '.packlist' -delete
}
